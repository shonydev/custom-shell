<Window x:Class="MyShell.Host.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyShell"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#12131A"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Height="32">
    <Window.Resources>
        <!-- Central palette/typography for every widget on the bar. Widgets
             pull these via SetResourceReference instead of hardcoding
             colors/fonts, so the whole bar's look can be changed from this
             one place. -->
        <FontFamily x:Key="BarFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="BarIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="BarForegroundBrush" Color="#E4E4EA" />
        <SolidColorBrush x:Key="BarMutedForegroundBrush" Color="#9A9AA6" />
        <SolidColorBrush x:Key="BarAccentBrush" Color="#5EA1F2" />
        <SolidColorBrush x:Key="BarSeparatorBrush" Color="#3A3B44" />
        <SolidColorBrush x:Key="BarHoverBrush" Color="#FFFFFF" Opacity="0.08" />

        <!-- Flat, borderless button: every icon/search button on the bar
             uses this so hovering feels like the rest of a Windows shell
             (soft highlight, no button "chrome"). -->
        <Style x:Key="BarTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource BarForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BarHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="LeftPanel" Grid.Column="0" Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="8,0,0,0" />
        <StackPanel x:Name="CenterPanel" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel x:Name="RightPanel" Grid.Column="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center" />
        <StackPanel x:Name="TrayPanel" Grid.Column="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,8,0" />
    </Grid>
</Window>
