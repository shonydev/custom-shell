<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyShell.Modules.SystemControls</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyShell.Core\MyShell.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- BrightnessWidget reads/writes WmiMonitorBrightness(Methods) under
         root\WMI - only needs this package, not the old NAudio dependency
         (VolumeWidget below talks to Core Audio directly via COM interop
         instead of pulling in NAudio, so it's the only new package here). -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
